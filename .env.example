# Copie para .env.local e preencha com os valores de
# Project Settings > Data API / API Keys no painel do Supabase.
# A anon key é pública por design (protegida pelo RLS) — segura para
# expor no navegador. Nunca coloque a service_role key aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
